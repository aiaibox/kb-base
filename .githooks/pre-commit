#!/usr/bin/env bash
# Refuse the commit if the repo does not lint. One copy, in kb-base; every repo
# points here with:  git config core.hooksPath ../base/.githooks
# Each repo's own scripts/lint.py runs base's rules and then its own.
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
[ -f "$REPO_ROOT/scripts/lint.py" ] || { echo "pre-commit: scripts/lint.py is missing; refusing to commit blind" >&2; exit 1; }
if ! python3 "$REPO_ROOT/scripts/lint.py" --quiet; then
  echo >&2; echo "pre-commit: lint failed, commit aborted." >&2
  echo "Fix the problems above, or use --no-verify if you truly must." >&2
  exit 1
fi
